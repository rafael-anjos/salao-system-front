        <h2 id="titulo-resumo" class="sr-only">Resumo do per\xEDodo</h2>\r
        <dl class="metricas">\r
          <div>\r
            <dt>Total de entradas</dt>\r
            <dd class="entrada">{{ totais.entradas | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</dd>\r
          </div>\r
          <div>\r
            <dt>Total de sa\xEDdas</dt>\r
            <dd class="saida">{{ totais.saidas | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</dd>\r
          </div>\r
          <div>\r
            <dt>Lucro l\xEDquido</dt>\r
            <dd class="lucro">{{ totais.lucro | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</dd>\r
          </div>\r
          <div>\r
            <dt>Contas a pagar em {{ nomeMesContas }}</dt>\r
            <dd class="conta">{{ contasPendentes | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</dd>\r
          </div>\r
        </dl>\r
        <p class="nota">Vendas e entradas do caixa entram no per\xEDodo. Sangria e conta marcada como paga entram nas sa\xEDdas. Conta pendente fica s\xF3 no valor laranja, at\xE9 ser paga.</p>\r
      </section>\r
    }\r
\r
    @if (aba === 'contas') {\r
      <section class="painel" aria-labelledby="titulo-contas">\r
        <header class="painel-cabecalho">\r
          <div>\r
            <h2 id="titulo-contas">Contas de {{ nomeMesContas }}</h2>\r
            <p>Fixa se repete todo m\xEAs. Parcelada dura as parcelas combinadas. Avulsa sai da lista quando \xE9 paga.</p>\r
          </div>\r
          <button class="primario" type="button" (click)="abrirConta()">+ Nova conta</button>\r
        </header>\r
\r
        @if (vencidas.length) {\r
          <p class="alerta" role="alert">\r
            {{ vencidas.length }} {{ vencidas.length === 1 ? 'conta vencida' : 'contas vencidas' }} \xB7 {{ totalVencido | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}\r
          </p>\r
        }\r
\r
        @if (contasMes.length === 0) {\r
          <p class="vazio">Nenhuma conta em aberto neste m\xEAs.</p>\r
        } @else {\r
          <div class="tabela-wrap">\r
            <table>\r
              <thead>\r
                <tr>\r
                  <th>Conta</th>\r
                  <th>Valor</th>\r
                  <th>Vencimento</th>\r
                  <th>Tipo</th>\r
                  <th>Status</th>\r
                  <th><span class="sr-only">A\xE7\xF5es</span></th>\r
                </tr>\r
              </thead>\r
              <tbody>\r
                @for (conta of contasMes; track conta.lancamentoId) {\r
                  <tr [class.vencida]="conta.vencida">\r
                    <td>\r
                      <strong>{{ conta.nome }}</strong>\r
                      @if (conta.tipo === 'parcelada') {\r
                        <span class="sub">Parcela {{ conta.numeroParcela }} de {{ conta.parcelas }}</span>\r
                      }\r
                    </td>\r
                    <td class="numero">{{ conta.valor | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
                    <td>{{ formatarData(conta.vencimento) }}</td>\r
                    <td><span class="tag" [attr.data-tipo]="conta.tipo">{{ rotuloTipo(conta.tipo) }}</span></td>\r
                    <td>\r
                      <span class="tag" [attr.data-status]="conta.status">{{ conta.status === 'pago' ? 'Pago' : 'Pendente' }}</span>\r
                    </td>\r
                    <td class="acoes-linha">\r
                      @if (confirmandoId === conta.contratoId) {\r
                        <span class="confirma">Encerrar a partir do pr\xF3ximo m\xEAs?</span>\r
                        <button class="btn-acao" type="button" (click)="encerrar(conta)">Encerrar</button>\r
                        <button class="btn-acao" type="button" (click)="confirmandoId = null">Voltar</button>\r
                      } @else {\r
                        @if (conta.status === 'pendente') {\r
                          <button class="btn-acao forte" type="button" (click)="pagar(conta)">Marcar como pago</button>\r
                        }\r
                        @if (conta.podeEncerrar) {\r
                          <button class="btn-acao" type="button" (click)="pedirEncerramento(conta)">Encerrar</button>\r
                        }\r
                      }\r
                    </td>\r
                  </tr>\r
                }\r
              </tbody>\r
            </table>\r
          </div>\r
        }\r
      </section>\r
    }\r
\r
    @if (aba === 'sangrias') {\r
      <section class="painel" aria-labelledby="titulo-sangrias">\r
        <header class="painel-cabecalho">\r
          <div>\r
            <h2 id="titulo-sangrias">Sangrias do per\xEDodo</h2>\r
            <p>Retirada sem categoria de produto. Cada uma reduz o lucro l\xEDquido.</p>\r
          </div>\r
          <button class="primario" type="button" (click)="abrirSangria()">+ Registrar sangria</button>\r
        </header>\r
\r
        @if (estado.sangriasDoPeriodo(intervalo.inicio, intervalo.fim).length === 0) {\r
          <p class="vazio">Nenhuma sangria neste per\xEDodo.</p>\r
        } @else {\r
          <ul class="lista">\r
            @for (sangria of estado.sangriasDoPeriodo(intervalo.inicio, intervalo.fim); track sangria.id) {\r
              <li>\r
                <span>\r
                  <strong>{{ sangria.descricao }}</strong>\r
                  <span class="sub">{{ formatarData(sangria.data) }}</span>\r
                </span>\r
                <strong class="saida">{{ sangria.valor | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</strong>\r
              </li>\r
            }\r
          </ul>\r
        }\r
      </section>\r
    }\r
\r
    @if (aba === 'receitas') {\r
      <section class="painel" aria-labelledby="titulo-servicos">\r
        <header class="painel-cabecalho">\r
          <div>\r
            <h2 id="titulo-servicos">Receita por servi\xE7o</h2>\r
            <p>Quantidade e valor no per\xEDodo, depois do desconto da venda.</p>\r
          </div>\r
        </header>\r
        @if (servicos.length === 0) {\r
          <p class="vazio">Nenhuma venda de servi\xE7o neste per\xEDodo.</p>\r
        } @else {\r
          <div class="tabela-wrap">\r
            <table>\r
              <thead>\r
                <tr>\r
                  <th>Servi\xE7o</th>\r
                  <th>Quantidade</th>\r
                  <th>Total gerado</th>\r
                  <th>% do total</th>\r
                </tr>\r
              </thead>\r
              <tbody>\r
                @for (linha of servicos; track linha.nome) {\r
                  <tr>\r
                    <td>{{ linha.nome }}</td>\r
                    <td class="numero">{{ linha.quantidade }}</td>\r
                    <td class="numero">{{ linha.total | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
                    <td class="numero">{{ linha.percentual | number:'1.1-1' }}%</td>\r
                  </tr>\r
                }\r
              </tbody>\r
            </table>\r
          </div>\r
        }\r
      </section>\r
\r
      <section class="painel" aria-labelledby="titulo-formas">\r
        <header class="painel-cabecalho">\r
          <h2 id="titulo-formas">Receita por forma de pagamento</h2>\r
        </header>\r
        <ul class="participacao">\r
          @for (linha of formas; track linha.nome) {\r
            <li>\r
              <div class="participacao-topo">\r
                <span>{{ linha.nome }}</span>\r
                <strong>{{ linha.total | currency:'BRL':'symbol':'1.2-2':'pt-BR' }} \xB7 {{ linha.percentual | number:'1.1-1' }}%</strong>\r
              </div>\r
              <div class="trilho" aria-hidden="true">\r
                <span [style.width.%]="linha.percentual"></span>\r
              </div>\r
            </li>\r
          }\r
        </ul>\r
      </section>\r
\r
      <section class="painel" aria-labelledby="titulo-origem">\r
        <header class="painel-cabecalho">\r
          <h2 id="titulo-origem">Servi\xE7os e revenda</h2>\r
        </header>\r
        <ul class="participacao">\r
          <li>\r
            <div class="participacao-topo">\r
              <span>Servi\xE7os</span>\r
              <strong>{{ origemReceita.servicos.total | currency:'BRL':'symbol':'1.2-2':'pt-BR' }} \xB7 {{ origemReceita.servicos.percentual | number:'1.1-1' }}%</strong>\r
            </div>\r
            <div class="trilho" aria-hidden="true">\r
              <span [style.width.%]="origemReceita.servicos.percentual"></span>\r
            </div>\r
          </li>\r
          <li>\r
            <div class="participacao-topo">\r
              <span>Revenda</span>\r
              <strong>{{ origemReceita.revenda.total | currency:'BRL':'symbol':'1.2-2':'pt-BR' }} \xB7 {{ origemReceita.revenda.percentual | number:'1.1-1' }}%</strong>\r
            </div>\r
            <div class="trilho revenda" aria-hidden="true">\r
              <span [style.width.%]="origemReceita.revenda.percentual"></span>\r
            </div>\r
          </li>\r
        </ul>\r
      </section>\r
    }\r
\r
    @if (aba === 'comparativo') {\r
      <section class="painel" aria-labelledby="titulo-comparativo">\r
        <header class="painel-cabecalho">\r
          <div>\r
            <h2 id="titulo-comparativo">Per\xEDodo atual e {{ rotuloComparacao }}</h2>\r
            <p>{{ textoPeriodo }} contra {{ textoPeriodoAnterior }}</p>\r
          </div>\r
        </header>\r
        <p class="delta" [attr.data-sentido]="variacaoLucro.sentido">{{ textoVariacao(variacaoLucro) }} no lucro l\xEDquido</p>\r
        <div class="tabela-wrap">\r
          <table>\r
            <thead>\r
              <tr>\r
                <th>Indicador</th>\r
                <th>Atual</th>\r
                <th>Anterior</th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              <tr>\r
                <td>Entradas</td>\r
                <td class="numero">{{ totais.entradas | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
                <td class="numero">{{ totaisAnteriores.entradas | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
              </tr>\r
              <tr>\r
                <td>Sa\xEDdas</td>\r
                <td class="numero">{{ totais.saidas | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
                <td class="numero">{{ totaisAnteriores.saidas | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
              </tr>\r
              <tr>\r
                <td>Lucro l\xEDquido</td>\r
                <td class="numero lucro">{{ totais.lucro | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
                <td class="numero">{{ totaisAnteriores.lucro | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</td>\r
              </tr>\r
            </tbody>\r
          </table>\r
        </div>\r
        <p class="nota">A compara\xE7\xE3o usa a mesma quantidade de dias.</p>\r
      </section>\r
    }\r
  </main>\r
\r
  @if (mostrarConta) {\r
    <div class="overlay" (click)="mostrarConta = false">\r
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="titulo-nova-conta" (click)="$event.stopPropagation()">\r
        <header class="titulo">\r
          <h2 id="titulo-nova-conta">Nova conta</h2>\r
          <p>Aluguel, energia, imposto ou um conserto. O valor entra nas sa\xEDdas s\xF3 quando a conta \xE9 paga.</p>\r
        </header>\r
        <form (ngSubmit)="salvarConta()">\r
          <label class="field">\r
            Nome da conta\r
            <input type="text" name="nomeConta" [(ngModel)]="nomeConta" placeholder="Aluguel, Energia, Internet" required autofocus>\r
          </label>\r
          <label class="field">\r
            Valor (R$)\r
            <input type="number" name="valorConta" min="0.01" step="0.01" placeholder="0,00" [(ngModel)]="valorConta" required>\r
          </label>\r
          <fieldset class="opcoes">\r
            <legend>Tipo</legend>\r
            <label><input type="radio" name="tipoConta" value="fixa" [(ngModel)]="tipoConta"> Fixa mensal</label>\r
            <label><input type="radio" name="tipoConta" value="parcelada" [(ngModel)]="tipoConta"> Parcelada</label>\r
            <label><input type="radio" name="tipoConta" value="avulsa" [(ngModel)]="tipoConta"> Avulsa</label>\r
          </fieldset>\r
          @if (tipoConta === 'parcelada') {\r
            <label class="field">\r
              Parcelas\r
              <input type="number" name="parcelas" min="2" max="48" step="1" [(ngModel)]="parcelasConta" required>\r
            </label>\r
          }\r
          @if (tipoConta === 'fixa') {\r
            <label class="field">\r
              Dia do vencimento\r
              <input type="number" name="diaConta" min="1" max="31" step="1" [(ngModel)]="diaConta" required>\r
            </label>\r
          } @else {\r
            <label class="field">\r
              Vencimento\r
              <input type="date" name="dataConta" [(ngModel)]="dataConta" required>\r
            </label>\r
          }\r
          <fieldset class="opcoes">\r
            <legend>Status</legend>\r
            <label><input type="radio" name="statusConta" value="pendente" [(ngModel)]="statusConta"> Pendente</label>\r
            <label><input type="radio" name="statusConta" value="pago" [(ngModel)]="statusConta"> Pago</label>\r
          </fieldset>\r
          @if (erroConta) {\r
            <p class="erro" role="alert">{{ erroConta }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="secundario" type="button" (click)="mostrarConta = false">Cancelar</button>\r
            <button class="primario" type="submit" [disabled]="processando">Salvar</button>\r
          </div>\r
        </form>\r
      </div>\r
    </div>\r
  }\r
\r
  @if (mostrarSangria) {\r
    <div class="overlay" (click)="mostrarSangria = false">\r
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="titulo-sangria" (click)="$event.stopPropagation()">\r
        <header class="titulo">\r
          <h2 id="titulo-sangria">Registrar sangria</h2>\r
          <p>Retirada pessoal ou pagamento a fornecedor, fora do estoque.</p>\r
        </header>\r
        <form (ngSubmit)="salvarSangria()">\r
          <label class="field">\r
            Descri\xE7\xE3o\r
            <input type="text" name="descricaoSangria" [(ngModel)]="descricaoSangria" placeholder="Retirada pessoal" required autofocus>\r
          </label>\r
          <label class="field">\r
            Valor (R$)\r
            <input type="number" name="valorSangria" min="0.01" step="0.01" placeholder="0,00" [(ngModel)]="valorSangria" required>\r
          </label>\r
          <label class="field">\r
            Data\r
            <input type="date" name="dataSangria" [(ngModel)]="dataSangria" [max]="hojeIso" required>\r
          </label>\r
          @if (erroSangria) {\r
            <p class="erro" role="alert">{{ erroSangria }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="secundario" type="button" (click)="mostrarSangria = false">Cancelar</button>\r
            <button class="primario" type="submit" [disabled]="processando">Registrar</button>\r
          </div>\r
        </form>\r
      </div>\r
    </div>\r
  }\r
</div>\r
`, styles: ['/* src/app/components/financeiro/financeiro.css */\n:host {\n  --ink: #1c3112;\n  --muted: #5a6854;\n  --line: color-mix(in srgb, #1c3112 14%, white);\n  --soft: color-mix(in srgb, #1c3112 7%, white);\n  --canvas: #f3f4f2;\n  --entrada: #146c36;\n  --saida: #9b1c2c;\n  --lucro: #7a5c12;\n  --conta: #9a4d08;\n  color: var(--ink);\n  font-family: "Montserrat", sans-serif;\n  caret-color: var(--ink);\n}\n.container {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  min-width: 0;\n  min-height: 100vh;\n  background: var(--canvas);\n}\n.container > header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem 1rem;\n  min-height: 10vh;\n  padding: 0.75rem 1.25rem;\n  background: white;\n  box-shadow: 1px 1px 7px 1px #b3b3b3;\n}\n.box-titulo h1 {\n  font-size: 1.875rem;\n  font-weight: 500;\n  letter-spacing: -0.02em;\n  text-wrap: balance;\n}\n.box-titulo .data {\n  margin-top: 0.15rem;\n  color: var(--muted);\n  font-size: 0.9375rem;\n}\n.header-acoes {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n.sub-filtros {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25rem;\n  padding: 0.2rem;\n  border-radius: 10px;\n  background: var(--soft);\n}\n.btn-sub {\n  padding: 0.4rem 0.85rem;\n  border: none;\n  border-radius: 8px;\n  background: none;\n  color: var(--muted);\n  font-family: inherit;\n  font-size: 0.8125rem;\n  font-weight: 500;\n  cursor: pointer;\n}\n.btn-sub.ativo {\n  background: white;\n  color: var(--ink);\n}\n.notification-btn {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  width: 35px;\n  height: 35px;\n  border: 1px solid var(--ink);\n  border-radius: 100%;\n  background: white;\n  cursor: pointer;\n  transition: background-color 180ms ease-out, border-color 180ms ease-out;\n}\n.notification-btn img {\n  width: 20px;\n  height: 20px;\n}\n.notification-btn .img-hover,\n.notification-btn .img-active {\n  displa