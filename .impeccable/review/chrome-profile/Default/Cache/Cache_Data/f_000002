                    <input type="checkbox" [name]="'condicao-' + condicao" [checked]="condicaoAtiva(condicao)" (change)="alternarCondicao(condicao, $any($event.target).checked)">\r
                    {{ condicao }}\r
                  </label>\r
                }\r
              </div>\r
            </fieldset>\r
\r
            <label class="field">\r
              Alergias e sensibilidade a produtos\r
              <textarea name="alergias" rows="2" [(ngModel)]="anamnese.alergias"></textarea>\r
            </label>\r
            <div class="grade">\r
              <label class="field">\r
                Teste de mecha\r
                <select name="testeMecha" [ngModel]="testeTexto" (ngModelChange)="definirTeste($event)">\r
                  <option value="">N\xE3o informado</option>\r
                  <option value="sim">Sim</option>\r
                  <option value="nao">N\xE3o</option>\r
                </select>\r
              </label>\r
              <label class="field">\r
                Data do teste\r
                <input type="date" name="testeData" [(ngModel)]="anamnese.testeMechaData">\r
              </label>\r
            </div>\r
            <label class="field">\r
              Observa\xE7\xF5es de sa\xFAde\r
              <textarea name="saude" rows="2" [(ngModel)]="anamnese.observacoesSaude" placeholder="Gestante, medicamento, o que a Paula precisar lembrar"></textarea>\r
            </label>\r
            <label class="field">\r
              Cuidados em casa\r
              <textarea name="cuidados" rows="2" [(ngModel)]="anamnese.cuidadosCasa"></textarea>\r
            </label>\r
            <label class="field">\r
              Prefer\xEAncias da cliente\r
              <textarea name="preferencias" rows="2" [(ngModel)]="anamnese.preferencias"></textarea>\r
            </label>\r
            <label class="check">\r
              <input type="checkbox" name="consentimentoAnamnese" [(ngModel)]="consentimentoAnamnese">\r
              Autorizo guardar dados de sa\xFAde e fotos desta cliente.\r
            </label>\r
            @if (erroAnamnese) {\r
              <p class="erro" role="alert">{{ erroAnamnese }}</p>\r
            }\r
            @if (avisoAnamnese) {\r
              <p class="ok" role="status">{{ avisoAnamnese }}</p>\r
            }\r
            <div class="foot-inline">\r
              <button class="agendamento-btn" type="submit">Salvar anamnese</button>\r
            </div>\r
          </form>\r
        }\r
\r
        @if (aba === 'atendimentos') {\r
          <section class="painel" aria-label="Atendimentos">\r
            <div class="barra-interna">\r
              <p>Ficha t\xE9cnica de cada visita, da mais recente para a mais antiga.</p>\r
              <button class="agendamento-btn" type="button" (click)="abrirFicha()">Registrar atendimento</button>\r
            </div>\r
            @for (ficha of fichas; track ficha.id) {\r
              <article class="visita">\r
                <header>\r
                  <h3>{{ formatarDia(ficha.data) }} \xB7 {{ ficha.servico }}</h3>\r
                  <strong>{{ ficha.valor | currency:'BRL':'symbol':'1.2-2':'pt-BR' }}</strong>\r
                </header>\r
                <p>{{ ficha.profissional }}</p>\r
                @for (produto of ficha.produtos; track $index) {\r
                  <p class="produto">\r
                    {{ produto.marca }} {{ produto.linha }}\r
                    @if (produto.cor) { \xB7 {{ produto.cor }} }\r
                    @if (produto.oxidante) { \xB7 ox {{ produto.oxidante }} }\r
                    @if (produto.proporcao) { \xB7 {{ produto.proporcao }} }\r
                    @if (produto.tempoPausa) { \xB7 pausa {{ produto.tempoPausa }} }\r
                  </p>\r
                }\r
                @if (ficha.observacoes) {\r
                  <p>{{ ficha.observacoes }}</p>\r
                }\r
                @if (ficha.retorno) {\r
                  <p class="retorno">{{ ficha.retorno }}</p>\r
                }\r
                @if (ficha.fotos.length) {\r
                  <div class="fotos">\r
                    @for (foto of fotosDaFicha(ficha, 'antes'); track foto.id) {\r
                      <figure>\r
                        <img [src]="foto.dados" alt="Antes do atendimento de {{ atual.nome }}">\r
                        <figcaption>Antes</figcaption>\r
                      </figure>\r
                    }\r
                    @for (foto of fotosDaFicha(ficha, 'depois'); track foto.id) {\r
                      <figure>\r
                        <img [src]="foto.dados" alt="Depois do atendimento de {{ atual.nome }}">\r
                        <figcaption>Depois</figcaption>\r
                      </figure>\r
                    }\r
                  </div>\r
                }\r
              </article>\r
            } @empty {\r
              <p class="vazio-formula">Nenhum atendimento com ficha t\xE9cnica.</p>\r
            }\r
          </section>\r
        }\r
      </div>\r
    } @else if (clienteId) {\r
      <header>\r
        <h1>Cliente</h1>\r
      </header>\r
      <div class="conteudo">\r
        <p class="vazio-formula">Esta cliente n\xE3o est\xE1 na lista.</p>\r
        <button class="agendamento-btn" type="button" (click)="voltarLista()">Voltar para clientes</button>\r
      </div>\r
    } @else {\r
      <header>\r
        <h1>Clientes</h1>\r
        <div class="header-btn">\r
          <button class="notification-btn" type="button" aria-label="Notifica\xE7\xF5es">\r
            <img class="img-padrao" src="notification-green.svg" alt="">\r
            <img class="img-hover" src="notification.svg" alt="">\r
            <img class="img-active" src="notification-green.svg" alt="">\r
          </button>\r
          <button class="agendamento-btn" type="button" (click)="abrirCadastro()">+ Novo cliente</button>\r
        </div>\r
      </header>\r
\r
      <div class="conteudo">\r
        <div class="barra-filtros">\r
          <input type="search" name="buscaCliente" placeholder="Buscar por nome ou telefone" [(ngModel)]="termo">\r
        </div>\r
        <div class="abas filtros" role="tablist" aria-label="Filtros de clientes">\r
          @for (item of filtros; track item.id) {\r
            <button class="btn-aba" type="button" role="tab" [class.ativo]="filtro === item.id" (click)="filtro = item.id">\r
              {{ item.nome }}\r
            </button>\r
          }\r
        </div>\r
\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Nome</th>\r
                <th>Telefone / WhatsApp</th>\r
                <th>\xDAltima visita</th>\r
                <th>Visitas</th>\r
                <th>Tags</th>\r
                <th>A\xE7\xF5es</th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (cliente of clientesVisiveis; track cliente.id) {\r
                <tr>\r
                  <td class="nome">{{ cliente.nome }}</td>\r
                  <td>{{ cliente.telefone || 'Sem telefone' }}</td>\r
                  <td>{{ resumoDe(cliente).ultimaVisita ? formatarDia(resumoDe(cliente).ultimaVisita) : 'Nenhuma' }}</td>\r
                  <td class="numero">{{ resumoDe(cliente).totalVisitas }}</td>\r
                  <td>\r
                    @if (cliente.tags.length) {\r
                      <ul class="tags">\r
                        @for (tag of cliente.tags; track tag) {\r
                          <li [class.alergia]="tag.toLowerCase() === 'alergia'">{{ tag }}</li>\r
                        }\r
                      </ul>\r
                    }\r
                  </td>\r
                  <td>\r
                    <div class="acoes">\r
                      <button class="btn-acao" type="button" (click)="abrirPerfil(cliente)">Abrir perfil</button>\r
                      <button class="btn-acao" type="button" [disabled]="!cliente.telefone" (click)="abrirWhatsapp(cliente)">WhatsApp</button>\r
                      @if (mensagemPronta) {\r
                        <button class="btn-acao" type="button" [disabled]="!cliente.telefone" (click)="abrirWhatsapp(cliente, true)">Mensagem</button>\r
                      }\r
                      <button class="btn-acao" type="button" (click)="agendar(cliente)">Agendar</button>\r
                    </div>\r
                  </td>\r
                </tr>\r
              } @empty {\r
                <tr>\r
                  <td class="vazio" colspan="6">Nenhuma cliente neste filtro.</td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>Mostrando {{ clientesVisiveis.length }} {{ clientesVisiveis.length === 1 ? 'cliente' : 'clientes' }}</span>\r
          </div>\r
        </div>\r
      </div>\r
    }\r
  </main>\r
\r
  @if (mostrarCadastro) {\r
    <div class="overlay" (click)="fecharCadastro()">\r
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="titulo-cadastro" (click)="$event.stopPropagation()">\r
        <header class="titulo">\r
          <h2 id="titulo-cadastro">{{ tituloCadastro }}</h2>\r
          <p>Nome e telefone s\xE3o obrigat\xF3rios. O restante completa a ficha.</p>\r
        </header>\r
        <form (ngSubmit)="salvarCadastro()">\r
          <div class="row">\r
            <label class="field">\r
              Nome\r
              <input type="text" name="nome" [(ngModel)]="nome" required>\r
            </label>\r
            <label class="field">\r
              Telefone / WhatsApp\r
              <input type="tel" name="telefone" [(ngModel)]="telefone" required>\r
            </label>\r
          </div>\r
          <div class="row">\r
            <label class="field">\r
              Data de nascimento\r
              <input type="date" name="nascimento" [(ngModel)]="nascimento">\r
            </label>\r
            <label class="field">\r
              E-mail\r
              <input type="email" name="email" [(ngModel)]="email">\r
            </label>\r
          </div>\r
          <label class="field">\r
            Instagram\r
            <input type="text" name="instagram" [(ngModel)]="instagram" placeholder="sem o @">\r
          </label>\r
          <label class="field">\r
            Tags\r
            <input type="text" name="tags" [(ngModel)]="tagsTexto" placeholder="VIP">\r
          </label>\r
          <label class="field">\r
            Observa\xE7\xF5es gerais\r
            <textarea name="observacoes" rows="3" [(ngModel)]="observacoes"></textarea>\r
          </label>\r
          <label class="check">\r
            <input type="checkbox" name="consentimento" [(ngModel)]="consentimento">\r
            Autorizo guardar dados de sa\xFAde e fotos desta cliente.\r
          </label>\r
          <label class="check">\r
            <input type="checkbox" name="inativa" [(ngModel)]="inativa">\r
            Cliente inativa\r
          </label>\r
          @if (erroCadastro) {\r
            <p class="erro" role="alert">{{ erroCadastro }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="cancel" type="button" (click)="fecharCadastro()">Cancelar</button>\r
            <button class="save" type="submit">Salvar</button>\r
          </div>\r
        </form>\r
      </div>\r
    </div>\r
  }\r
\r
  @if (mostrarFicha && cliente) {\r
    <div class="overlay" (click)="fecharFicha()">\r
      <div class="sheet sheet-larga" role="dialog" aria-modal="true" aria-labelledby="titulo-ficha" (click)="$event.stopPropagation()">\r
        <header class="titulo">\r
          <h2 id="titulo-ficha">Ficha do atendimento</h2>\r
          <p>O que foi usado no cabelo, para o pr\xF3ximo retoque.</p>\r
        </header>\r
        <form (ngSubmit)="salvarFicha()">\r
          <div class="row">\r
            <label class="field">\r
              Data\r
              <input type="date" name="fichaData" [(ngModel)]="fichaData" required>\r
            </label>\r
            <label class="field">\r
              Valor cobrado\r
              <input type="number" name="fichaValor" min="0" step="0.01" [(ngModel)]="fichaValor">\r
            </label>\r
          </div>\r
          <div class="row">\r
            <label class="field">\r
              Servi\xE7o\r
              <input type="text" name="fichaServico" [(ngModel)]="fichaServico" required>\r
            </label>\r
            <label class="field">\r
              Profissional\r
              <input type="text" name="fichaProfissional" [(ngModel)]="fichaProfissional" required>\r
            </label>\r
          </div>\r
          @for (produto of fichaProdutos; track $index) {\r
            <fieldset>\r
              <legend>Produto {{ $index + 1 }}</legend>\r
              <div class="row">\r
                <label class="field">Marca <input type="text" [name]="'marca-' + $index" [(ngModel)]="produto.marca"></label>\r
                <label class="field">Linha <input type="text" [name]="'linha-' + $index" [(ngModel)]="produto.linha"></label>\r
              </div>\r
              <div class="row">\r
                <label class="field">Cor / tonalidade <input type="text" [name]="'cor-' + $index" [(ngModel)]="produto.cor"></label>\r
                <label class="field">Oxidante <input type="text" [name]="'ox-' + $index" [(ngModel)]="produto.oxidante" placeholder="20 volumes"></label>\r
              </div>\r
              <div class="row">\r
                <label class="field">Propor\xE7\xE3o <input type="text" [name]="'prop-' + $index" [(ngModel)]="produto.proporcao" placeholder="1:1"></label>\r
                <label class="field">Tempo de pausa <input type="text" [name]="'pausa-' + $index" [(ngModel)]="produto.tempoPausa" placeholder="35 min"></label>\r
              </div>\r
            </fieldset>\r
          }\r
          @if (fichaProdutos.length < 3) {\r
            <button class="btn-acao" type="button" (click)="adicionarProduto()">Adicionar produto</button>\r
          }\r
          <label class="field">\r
            Observa\xE7\xF5es do atendimento\r
            <textarea name="fichaObs" rows="2" [(ngModel)]="fichaObservacoes"></textarea>\r
          </label>\r
          <label class="field">\r
            Recomenda\xE7\xE3o de retorno\r
            <input type="text" name="fichaRetorno" [(ngModel)]="fichaRetorno" placeholder="Retoque em 30 dias">\r
          </label>\r
          <div class="row">\r
            <label class="field">\r
              Foto antes\r
              <input type="file" accept="image/*" (change)="escolherFoto($event, 'antes')">\r
            </label>\r
            <label class="field">\r
              Foto depois\r
              <input type="file" accept="image/*" (change)="escolherFoto($event, 'depois')">\r
            </label>\r
          </div>\r
          @if (erroFicha) {\r
            <p class="erro" role="alert">{{ erroFicha }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="cancel" type="button" (click)="fecharFicha()">Cancelar</button>\r
            <button class="save" type="submit">Salvar ficha</button>\r
          </div>\r
        </form>\r
      </div>\r
    </div>\r
  }\r
</div>\r
`, styles: ['/* src/app/components/clientes/clientes.css */\n:host {\n  --ink: #1c3112;\n  --muted: #5a6854;\n  --line: color-mix(in srgb, #1c3112 14%, white);\n  --canvas: #f3f4f2;\n  --critico: #9b1c2c;\n  font-family: "Montserrat", sans-serif;\n  color: var(--ink);\n}\n:host ::selection {\n  background: var(--ink);\n  color: white;\n}\n.container {\n  display: flex;\n  background-color: var(--canvas);\n  min-height: 100vh;\n  width: 100%;\n}\nmain {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  min-height: 100vh;\n  min-width: 0;\n}\nmain > header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  min-height: 10vh;\n  width: 100%;\n  padding: 0.75rem 1.25rem;\n  background-color: white;\n  box-shadow: 1px 1px 7px 1px #b3b3b3;\n}\nmain > header h1 {\n  font-size: 1.875rem;\n  font-weight: 500;\n  letter-spacing: -0.02em;\n}\n.box-titulo {\n  min-width: 0;\n}\n.header-btn,\n.acoes,\n.foot-btn,\n.foot-inline,\n.barra-interna {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n.agendamento-btn,\n.notification-btn,\n.btn-aba,\n.btn-acao,\n.cancel,\n.save,\n.secundario {\n  font-family: inherit;\n}\n.agendamento-btn,\n.secundario,\n.save {\n  font-weight: 500;\n  font-size: 0.9375rem;\n  height: 2.375rem;\n  padding: 0 1.1rem;\n  border-radius: 10px;\n  cursor: pointer;\n}\n.agendamento-btn,\n.save {\n  background-color: var(--ink);\n  border: 1px solid var(--ink);\n  color: white;\n}\n.secundario {\n  background: white;\n  border: 1px solid var(--ink);\n  color: var(--ink);\n}\n.agendamento-btn:hover,\n.save:hover,\n.secundario:hover {\n  background-color: white;\n  color: var(--ink);\n}\n.secundario:hover {\n  background: var(--ink);\n  color: white;\n}\n.secundario:disabled,\n.btn-acao:disabled {\n  cursor: not-allowed;\n  opacity: 0.45;\n}\n.notification-btn {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  border: 1px solid var(--ink);\n  background-color: white;\n