      }\r
\r
      @if (aviso && !painel) {\r
        <p class="ok" role="status">{{ aviso }}</p>\r
      }\r
\r
      @if (aba === 'salao') {\r
        <section class="painel-senha">\r
          <h2>Dados do sal\xE3o</h2>\r
          <p>O nome aparece no caixa, no financeiro e nos relat\xF3rios.</p>\r
          <form (ngSubmit)="salvarSalao()">\r
            <label class="field">\r
              Nome\r
              <input type="text" name="nomeSalao" [(ngModel)]="nomeSalao" placeholder="Nome do est\xFAdio" required>\r
            </label>\r
            <label class="field">\r
              Telefone\r
              <input type="tel" name="telefoneSalao" [(ngModel)]="telefoneSalao" placeholder="(11) 99999-0000" required>\r
            </label>\r
            <label class="field">\r
              Endere\xE7o\r
              <input type="text" name="enderecoSalao" [(ngModel)]="enderecoSalao" placeholder="Rua, n\xFAmero, bairro" required>\r
            </label>\r
            @if (erro) {\r
              <p class="erro" role="alert">{{ erro }}</p>\r
            }\r
            <div class="foot-btn senha-acoes">\r
              <button class="save" type="submit">Salvar dados</button>\r
            </div>\r
          </form>\r
        </section>\r
      }\r
\r
      @if (aba === 'horarios') {\r
        @if (erro) {\r
          <p class="erro" role="alert">{{ erro }}</p>\r
        }\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Dia</th>\r
                <th>Abertura</th>\r
                <th>Fechamento</th>\r
                <th>Situa\xE7\xE3o</th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (horario of horarios; track horario.dia) {\r
                <tr>\r
                  <td class="nome">{{ nomeDia(horario.dia) }}</td>\r
                  <td>\r
                    <input\r
                      type="time"\r
                      [name]="'abertura-' + horario.dia"\r
                      [(ngModel)]="horario.abertura"\r
                      [disabled]="!horario.ativo"\r
                      [attr.aria-label]="'Abertura de ' + nomeDia(horario.dia)">\r
                  </td>\r
                  <td>\r
                    <input\r
                      type="time"\r
                      [name]="'fechamento-' + horario.dia"\r
                      [(ngModel)]="horario.fechamento"\r
                      [disabled]="!horario.ativo"\r
                      [attr.aria-label]="'Fechamento de ' + nomeDia(horario.dia)">\r
                  </td>\r
                  <td>\r
                    <button\r
                      class="btn-status"\r
                      type="button"\r
                      [class.fechado]="!horario.ativo"\r
                      [attr.aria-pressed]="horario.ativo"\r
                      (click)="alternarDia(horario)">\r
                      {{ horario.ativo ? 'Aberto' : 'Fechado' }}\r
                    </button>\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>Abertura e fechamento de cada dia. Dias fechados ficam fora da agenda.</span>\r
          </div>\r
        </div>\r
      }\r
\r
      @if (aba === 'bloqueios') {\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Data</th>\r
                <th>Hor\xE1rio</th>\r
                <th>Motivo</th>\r
                <th></th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (bloqueio of bloqueios; track bloqueio.id) {\r
                <tr>\r
                  <td class="nome">{{ periodo(bloqueio) }}</td>\r
                  <td>{{ horarioBloqueio(bloqueio) }}</td>\r
                  <td>{{ bloqueio.motivo }}</td>\r
                  <td>\r
                    <div class="acoes">\r
                      <button class="btn-acao" type="button" (click)="abrirEdicao(bloqueio)">Editar</button>\r
                      <button class="btn-acao" type="button" (click)="abrirRemocao(bloqueio)">Remover</button>\r
                    </div>\r
                  </td>\r
                </tr>\r
              } @empty {\r
                <tr>\r
                  <td class="vazio" colspan="4">Nenhum feriado ou folga bloqueado.</td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>Mostrando {{ bloqueios.length }} bloqueios</span>\r
          </div>\r
        </div>\r
      }\r
\r
      @if (aba === 'usuarios') {\r
        @if (erro && !painel) {\r
          <p class="erro" role="alert">{{ erro }}</p>\r
        }\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Nome</th>\r
                <th>Perfil</th>\r
                <th>Acesso</th>\r
                <th>Situa\xE7\xE3o</th>\r
                <th></th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (usuarioItem of usuarios; track usuarioItem.id) {\r
                <tr>\r
                  <td class="nome">{{ usuarioItem.nome }}</td>\r
                  <td>{{ rotuloPerfil(usuarioItem) }}</td>\r
                  <td>{{ resumoAcessos(usuarioItem) }}</td>\r
                  <td>{{ usuarioItem.ativo ? 'Ativa' : 'Inativa' }}</td>\r
                  <td>\r
                    @if (usuarioItem.perfil === 'OPERADOR') {\r
                      <div class="acoes">\r
                        <button class="btn-acao" type="button" (click)="abrirAcessos(usuarioItem)">Acesso</button>\r
                        <button class="btn-acao" type="button" (click)="abrirStatusUsuario(usuarioItem)">\r
                          {{ usuarioItem.ativo ? 'Desativar' : 'Reativar' }}\r
                        </button>\r
                      </div>\r
                    }\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>Mostrando {{ usuarios.length }} {{ usuarios.length === 1 ? 'usu\xE1ria' : 'usu\xE1rias' }}</span>\r
          </div>\r
        </div>\r
      }\r
\r
      @if (aba === 'categorias') {\r
        <div class="toolbar">\r
          <div class="abas" role="tablist">\r
            <button class="btn-aba" type="button" role="tab" [class.ativo]="tipoCategoria === 'estoque'" (click)="mudarTipoCategoria('estoque')">\r
              Estoque\r
            </button>\r
            <button class="btn-aba" type="button" role="tab" [class.ativo]="tipoCategoria === 'despesa'" (click)="mudarTipoCategoria('despesa')">\r
              Despesa\r
            </button>\r
          </div>\r
        </div>\r
        @if (erro && !painel) {\r
          <p class="erro" role="alert">{{ erro }}</p>\r
        }\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Nome</th>\r
                @if (tipoCategoria === 'estoque') {\r
                  <th>Produtos</th>\r
                }\r
                <th></th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (categoria of categoriasVisiveis; track categoria.id) {\r
                <tr>\r
                  <td class="nome">{{ categoria.nome }}</td>\r
                  @if (tipoCategoria === 'estoque') {\r
                    <td>{{ produtosDaCategoria(categoria.nome) }}</td>\r
                  }\r
                  <td>\r
                    <div class="acoes">\r
                      <button class="btn-acao" type="button" (click)="abrirEdicaoCategoria(categoria)">Editar</button>\r
                      <button class="btn-acao" type="button" (click)="abrirRemocaoCategoria(categoria)">Remover</button>\r
                    </div>\r
                  </td>\r
                </tr>\r
              } @empty {\r
                <tr>\r
                  <td class="vazio" [attr.colspan]="tipoCategoria === 'estoque' ? 3 : 2">Nenhuma categoria cadastrada.</td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>\r
              Mostrando {{ categoriasVisiveis.length }}\r
              {{ tipoCategoria === 'estoque' ? 'categorias de estoque' : 'categorias de despesa' }}\r
            </span>\r
          </div>\r
        </div>\r
      }\r
\r
      @if (aba === 'formas') {\r
        @if (erro) {\r
          <p class="erro" role="alert">{{ erro }}</p>\r
        }\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Forma</th>\r
                <th>Situa\xE7\xE3o</th>\r
                <th>Parcelas</th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (forma of formasEdicao; track forma.forma) {\r
                <tr>\r
                  <td class="nome">{{ forma.forma }}</td>\r
                  <td>\r
                    <button\r
                      class="btn-status"\r
                      type="button"\r
                      [class.fechado]="!forma.ativa"\r
                      [attr.aria-pressed]="forma.ativa"\r
                      (click)="alternarForma(forma)">\r
                      {{ forma.ativa ? 'Ativa' : 'Inativa' }}\r
                    </button>\r
                  </td>\r
                  <td>\r
                    @if (forma.forma === 'Cart\xE3o de cr\xE9dito') {\r
                      <input\r
                        type="number"\r
                        name="maxParcelas"\r
                        min="1"\r
                        max="24"\r
                        step="1"\r
                        [(ngModel)]="forma.maxParcelas"\r
                        aria-label="M\xE1ximo de parcelas no cr\xE9dito">\r
                    } @else {\r
                      \xC0 vista\r
                    }\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>O caixa oferece s\xF3 as formas ativas. As parcelas valem para o cr\xE9dito.</span>\r
          </div>\r
        </div>\r
      }\r
\r
      @if (aba === 'taxas') {\r
        @if (erro) {\r
          <p class="erro" role="alert">{{ erro }}</p>\r
        }\r
        <div class="container-tabela">\r
          <table class="tabela">\r
            <thead>\r
              <tr>\r
                <th>Forma</th>\r
                <th>Taxa</th>\r
                <th>Em R$ 100</th>\r
              </tr>\r
            </thead>\r
            <tbody>\r
              @for (forma of formasEdicao; track forma.forma) {\r
                <tr>\r
                  <td class="nome">{{ forma.forma }}</td>\r
                  <td>\r
                    <input\r
                      type="number"\r
                      [name]="'taxa-' + forma.forma"\r
                      min="0"\r
                      max="100"\r
                      step="0.01"\r
                      [(ngModel)]="forma.taxaPercentual"\r
                      [attr.aria-label]="'Taxa de ' + forma.forma">\r
                    <span class="sufixo">%</span>\r
                  </td>\r
                  <td>R$ {{ exemploTaxa(forma) | number:'1.2-2':'pt-BR' }}</td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
          <div class="rodape-tabela">\r
            <span>O caixa continua com o valor pago pela cliente. O lucro das vendas desconta essa taxa.</span>\r
          </div>\r
        </div>\r
      }\r
\r
      @if (aba === 'desconto') {\r
        <section class="painel-senha">\r
          <h2>Desconto m\xE1ximo</h2>\r
          <p>Porcentagem do valor da venda. 100% permite descontar at\xE9 o total. 0% n\xE3o permite desconto.</p>\r
          <form (ngSubmit)="salvarDesconto()">\r
            <label class="field">\r
              Teto (%)\r
              <input type="number" name="descontoMaximo" min="0" max="100" step="0.01" [(ngModel)]="descontoMaximo" required>\r
            </label>\r
            <p class="exemplo">Em uma venda de R$ 100, o caixa pode descontar at\xE9 R$ {{ exemploDesconto | number:'1.2-2':'pt-BR' }}.</p>\r
            @if (erro) {\r
              <p class="erro" role="alert">{{ erro }}</p>\r
            }\r
            <div class="foot-btn senha-acoes">\r
              <button class="save" type="submit">Salvar desconto</button>\r
            </div>\r
          </form>\r
        </section>\r
      }\r
\r
      @if (aba === 'backup') {\r
        <section class="painel-senha">\r
          <h2>Backup e exporta\xE7\xE3o</h2>\r
          <p>O arquivo guarda os cadastros e os movimentos desta sess\xE3o. A senha fica de fora.</p>\r
          <div class="senha-acoes backup-acoes">\r
            <button class="save" type="button" (click)="exportarBackup()">Exportar dados</button>\r
          </div>\r
          <label class="field arquivo">\r
            Restaurar um backup\r
            <input type="file" name="backup" accept="application/json,.json" (change)="escolherBackup($event)">\r
          </label>\r
        </section>\r
      }\r
\r
      @if (aba === 'senha') {\r
        <section class="painel-senha">\r
          <h2>Alterar senha</h2>\r
          <p>A nova senha vale para a conta de {{ usuario }} nesta sess\xE3o.</p>\r
          <form (ngSubmit)="alterarSenha()">\r
            <label class="field">\r
              Senha atual\r
              <input type="password" name="senhaAtual" [(ngModel)]="senhaAtual" autocomplete="current-password" required>\r
            </label>\r
            <label class="field">\r
              Nova senha\r
              <input type="password" name="senhaNova" [(ngModel)]="senhaNova" autocomplete="new-password" required>\r
            </label>\r
            <label class="field">\r
              Confirmar nova senha\r
              <input type="password" name="senhaConfirmacao" [(ngModel)]="senhaConfirmacao" autocomplete="new-password" required>\r
            </label>\r
            @if (erro) {\r
              <p class="erro" role="alert">{{ erro }}</p>\r
            }\r
            <div class="foot-btn senha-acoes">\r
              <button class="save" type="submit">Alterar senha</button>\r
            </div>\r
          </form>\r
        </section>\r
      }\r
    </div>\r
  </main>\r
\r
  @if (painel) {\r
    <div class="overlay" (click)="fecharPainel()">\r
      <div\r
        class="sheet"\r
        role="dialog"\r
        aria-modal="true"\r
        aria-labelledby="config-titulo"\r
        (click)="$event.stopPropagation()">\r
        <header class="titulo">\r
          <h2 id="config-titulo">{{ tituloPainel }}</h2>\r
          @if (painel === 'bloqueio') {\r
            <p>Feriados e folgas, com o motivo. O bloqueio pode ser o dia inteiro ou s\xF3 um hor\xE1rio.</p>\r
          } @else if (painel === 'remover') {\r
            <p>{{ alvo?.motivo }} sai da lista de datas bloqueadas.</p>\r
          } @else if (painel === 'usuario') {\r
            <p>O cadastro entra como operador. Marque as telas que ela pode abrir.</p>\r
          } @else if (painel === 'acessos') {\r
            <p>Marque as telas que {{ usuarioAlvo?.nome }} pode abrir.</p>\r
          } @else if (painel === 'status-usuario' && usuarioAlvo?.ativo) {\r
            <p>{{ usuarioAlvo?.nome }} deixa de entrar no sistema. O hist\xF3rico do sal\xE3o permanece.</p>\r
          } @else if (painel === 'status-usuario') {\r
            <p>{{ usuarioAlvo?.nome }} volta a entrar com as telas j\xE1 marcadas.</p>\r
          } @else if (painel === 'restaurar') {\r
            <p>Os cadastros e os movimentos desta sess\xE3o passam a ser os do arquivo.</p>\r
          } @else if (painel === 'categoria' && tipoCategoria === 'estoque') {\r
            <p>O nome aparece no filtro e na lista de produtos do estoque.</p>\r
          } @else if (painel === 'categoria') {\r
            <p>Aluguel, energia, imposto e as demais sa\xEDdas do sal\xE3o.</p>\r
          } @else {\r
            <p>{{ categoriaAlvo?.nome }} sai da lista de categorias.</p>\r
          }\r
        </header>\r
\r
        @if (painel === 'bloqueio') {\r
          <form (ngSubmit)="salvarBloqueio()">\r
            <div class="datas">\r
              <label class="field">\r
                Data inicial\r
                <input type="date" name="dataInicio" [(ngModel)]="dataInicio" required>\r
              </label>\r
              <label class="field">\r
                Data final\r
                <input type="date" name="dataFim" [(ngModel)]="dataFim" [min]="dataInicio">\r
              </label>\r
            </div>\r
\r
            <label class="check">\r
              <input type="checkbox" name="diaInteiro" [(ngModel)]="diaInteiro">\r
              Dia inteiro\r
            </label>\r
\r
            @if (!diaInteiro) {\r
              <div class="datas">\r
                <label class="field">\r
                  In\xEDcio\r
                  <input type="time" name="horaInicio" [(ngModel)]="horaInicio" required>\r
                </label>\r
                <label class="field">\r
                  Fim\r
                  <input type="time" name="horaFim" [(ngModel)]="horaFim" required>\r
                </label>\r
              </div>\r
            }\r
\r
            <label class="field">\r
              Motivo\r
              <input type="text" name="motivo" [(ngModel)]="motivo" placeholder="Feriado, folga ou outro motivo" required>\r
            </label>\r
\r
            @if (erro) {\r
              <p class="erro" role="alert">{{ erro }}</p>\r
            }\r
\r
            <div class="foot-btn">\r
              <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
              <button class="save" type="submit">Salvar</button>\r
            </div>\r
          </form>\r
        } @else if (painel === 'usuario' || painel === 'acessos') {\r
          <form (ngSubmit)="painel === 'usuario' ? salvarUsuario() : salvarAcessos()">\r
            @if (painel === 'usuario') {\r
              <label class="field">\r
                Nome\r
                <input type="text" name="nomeUsuario" [(ngModel)]="nomeUsuario" placeholder="Nome da funcion\xE1ria" required>\r
              </label>\r
              <p class="perfil-fixo">Perfil: Operador</p>\r
            }\r
            <fieldset class="acessos">\r
              <legend>Telas</legend>\r
              @for (modulo of modulos; track modulo.id) {\r
                <label class="check">\r
                  <input\r
                    type="checkbox"\r
                    [name]="'acesso-' + modulo.id"\r
                    [checked]="temAcesso(modulo.id)"\r
                    (change)="alternarAcesso(modulo.id, $event)">\r
                  {{ modulo.nome }}\r
                </label>\r
              }\r
            </fieldset>\r
            @if (erro) {\r
              <p class="erro" role="alert">{{ erro }}</p>\r
            }\r
            <div class="foot-btn">\r
              <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
              <button class="save" type="submit">Salvar</button>\r
            </div>\r
          </form>\r
        } @else if (painel === 'categoria') {\r
          <form (ngSubmit)="salvarCategoria()">\r
            <label class="field">\r
              Nome\r
              <input\r
                type="text"\r
                name="nomeCategoria"\r
                [(ngModel)]="nomeCategoria"\r
                [placeholder]="tipoCategoria === 'estoque' ? 'Ex: Hidratante' : 'Ex: Aluguel'"\r
                required>\r
            </label>\r
            @if (erro) {\r
              <p class="erro" role="alert">{{ erro }}</p>\r
            }\r
            <div class="foot-btn">\r
              <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
              <button class="save" type="submit">Salvar</button>\r
            </div>\r
          </form>\r
        } @else if (painel === 'restaurar') {\r
          @if (erro) {\r
            <p class="erro" role="alert">{{ erro }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
            <button class="save" type="button" (click)="confirmarRestauracao()">Restaurar</button>\r
          </div>\r
        } @else if (painel === 'status-usuario') {\r
          @if (erro) {\r
            <p class="erro" role="alert">{{ erro }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
            <button class="save" type="button" (click)="confirmarStatusUsuario()">\r
              {{ usuarioAlvo?.ativo ? 'Desativar' : 'Reativar' }}\r
            </button>\r
          </div>\r
        } @else if (painel === 'remover-categoria') {\r
          @if (erro) {\r
            <p class="erro" role="alert">{{ erro }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
            <button class="save" type="button" (click)="confirmarRemocaoCategoria()">Remover</button>\r
          </div>\r
        } @else {\r
          @if (erro) {\r
            <p class="erro" role="alert">{{ erro }}</p>\r
          }\r
          <div class="foot-btn">\r
            <button class="cancel" type="button" (click)="fecharPainel()">Cancelar</button>\r
            <button class="save" type="button" (click)="confirmarRemocao()">Remover</button>\r
          </div>\r
        }\r
      </div>\r
    </div>\r
